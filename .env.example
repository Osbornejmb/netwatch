# Set these in the launching environment. NetWatch does not load this file automatically.
NETWATCH_DB=data/netwatch.sqlite
NETWATCH_PORT=4317

# Monitoring and discovery require explicit opt-in. Set a flag to 1 to enable it.
NETWATCH_ICMP=0
NETWATCH_SNMP=0
NETWATCH_DISCOVERY=0
NETWATCH_DISCOVERY_ICMP=0
NETWATCH_INFRASTRUCTURE_ONLY=0

# Shortest IPv4 prefix eligible for discovery ICMP (16 through 30).
NETWATCH_DISCOVERY_MAX_PREFIX=24

# Optional additions and lower limits for manually started LLDP discovery runs.
NETWATCH_LLDP_CIDRS=
NETWATCH_LLDP_MAX_DEVICES=200
NETWATCH_LLDP_MAX_DEPTH=8
NETWATCH_LLDP_MAX_NEIGHBORS=512
NETWATCH_LLDP_TIME_MS=300000

# Sustained link quality thresholds. Three compatible intervals are required.
NETWATCH_LINK_ERRORS_PER_SEC=1
NETWATCH_LINK_DISCARDS_PER_SEC=10

# Optional SNMPv3 context for switch forwarding tables (exact management IP and context).
# Obtain each switch management IPv4 from its console (show ip interface brief)
# and exact forwarding context from show snmp context. Replace both labels.
# NETWATCH_SNMP_PORT_CONTEXTS=<SWITCH_MANAGEMENT_IPV4>=<VLAN_CONTEXT>
